{
  "name": "@kuflow/kuflow-rest-generator",
  "version": "0.0.1",
  "private": true,
  "devDependencies": {
    "autorest": "3.8.0"
  },
  "scripts": {
    "autorest": "autorest",
    "generate": "pnpm run generate:autorest && pnpm run generate:move && pnpm run generate:format",
    "generate:autorest": "AUTOREST_HOME=$(pwd) autorest --version=3.10.9 readme.md",
    "generate:move": "pnpm run generate:move:clean && pnpm run generate:move:mkdir && pnpm run generate:move:cp && pnpm run generate:move:rm",
    "generate:move:clean": "rm -rf ../src/generated/java/",
    "generate:move:mkdir": "mkdir -p ../src/generated/java/",
    "generate:move:cp": "cp -r ../target/openapi-generated/src/main/java/* ../src/generated/java/",
    "generate:move:rm": "rm -rf ../target/openapi-generated",
    "generate:format": "cd ../../ && ./mvnw spotless:apply@spotless-apply-generated -pl kuflow-rest"
  }
}
